@host = https://localhost:5443/api

#region List tasks

# Returns first 5 tasks
# @name ListTop5TasksRequest
GET {{host}}/tasks?limit=5
Accept: application/json

###

# Returns next 5 tasks
GET {{host}}/tasks?limit=5&cursor={{ListTop5TasksRequest.response.body.items[4].id}}
Accept: application/json

###

# Returns first 5 tasks matched given search term
# @name SearchTop5TasksRequest
GET {{host}}/tasks?search=integer&limit=5
Accept: application/json

###

# Returns next 5 tasks matched given search term
GET {{host}}/tasks?search=integer&limit=5&cursor={{SearchTop5TasksRequest.response.body.items[4].id}}
Accept: application/json

###

# Fails - limit must be >= 1
GET {{host}}/tasks?limit=-10
Accept: application/json

###

# Fails - limit must be <= 1000
GET {{host}}/tasks?limit=2147483647
Accept: application/json

###

# Fails - limit is invalid int
GET {{host}}/tasks?limit=1e20
Accept: application/json

###

# Returns items, taking the DEFAULT value of limit 100
GET {{host}}/tasks
Accept: application/json

###

# Fails - cursor must be positive int value
GET {{host}}/tasks?limit=5&cursor=0
Accept: application/json

###

# Fails - cursor is invalid int value
GET {{host}}/tasks?limit=5&cursor=1e20
Accept: application/json

#endregion // List tasks

###

#region Get task by id

# Returns task with given id
GET {{host}}/tasks/1
Accept: application/json

###

# Fails - task with given id does not exist
GET {{host}}/tasks/2147483647
Accept: application/json

###

# Fails - id must be positive int value
GET {{host}}/tasks/-101
Accept: application/json

###

# Fails - id is invalid int
GET {{host}}/tasks/1e20
Accept: application/json

#endregion // Get task by id

###

#region Add task

@taskUniqueToken = {{$guid}}

# Adds task
# @name AddTaskRequest
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}"
}

###

# Adds completed task
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true
}

###

# Adds task with specific "createdAt" value
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "createdAt": "2026-03-01T15:00:00"
}

###

# Adds task with "createdAt" specified as UTC value
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "createdAt": "2026-03-01T15:00:00Z"
}

###

# Adds task with "createdAt" specified as datetime with timezone
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "createdAt": "2026-03-01T15:00:00+05:00"
}

###

# Fails - missing request body
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

###

# Fails - missing title
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "description": "Description {{taskUniqueToken}}"
}

###

# Fails - title is empty
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "",
    "description": "Description {{taskUniqueToken}}"
}

###

# Fails - title length is greater than 128 characters
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task title too loooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooong",
    "description": "Description {{taskUniqueToken}}"
}

###

# Fails - title is not unique
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "{{AddTaskRequest.response.body.title}}",
    "description": "Description {{taskUniqueToken}}"
}

###

# Fails - description length is greater than 4096 characters
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description too "
}

###

#endregion // Add task

###

#region Update task

# @name AddTaskToUpdate1
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}"
}

###

# @name AddTaskToUpdate2
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}"
}

###

# Updates task
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "title": "{{AddTaskToUpdate1.response.body.title}}.UPDATED",
    "description": "{{AddTaskToUpdate1.response.body.description}}.UPDATED",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - task not found
PUT {{host}}/tasks/2147483647
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - id must be positive int value
PUT {{host}}/tasks/-101
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - id is invalid int
PUT {{host}}/tasks/1e20
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - missing request body
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

###

# Fails - missing title
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - title is empty
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "title": "",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - title is not unique
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "title": "{{AddTaskToUpdate2.response.body.title}}",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - title length is greater than 128 characters
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "title": "Task title too loooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooong",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - description length is greater than 128 characters
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description too ",
    "isCompleted": true,
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - missing "isCompleted" field
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "createdAt": "2026-03-01T15:00:01"
}

###

# Fails - missing "createdAt" field
PUT {{host}}/tasks/{{AddTaskToUpdate1.response.body.id}}
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}",
    "isCompleted": true
}

#endregion // Update task

###

#region Delete task

# @name AddTaskToDelete
POST {{host}}/tasks
Content-Type: application/json
Accept: application/json

{
    "title": "Task {{taskUniqueToken}}",
    "description": "Description {{taskUniqueToken}}"
}

###

# Deletes task
DELETE {{host}}/tasks/{{AddTaskToDelete.response.body.id}}
Accept: application/json

###

# Fails - task not found
DELETE {{host}}/tasks/2147483647
Accept: application/json

###

# Fails - id must be positive int value
DELETE {{host}}/tasks/-101
Accept: application/json

###

# Fails - id is invalid int
DELETE {{host}}/tasks/1e20
Accept: application/json

#endregion // Delete task

###
